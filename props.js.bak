const PROPS = [];
for (const [sk, cats] of Object.entries(RAW))
  for (const [cat, items] of Object.entries(cats))
    items.forEach(([name, size], i) =>
      PROPS.push({ id: `${sk}-${cat}-${String(i + 1).padStart(2, '0')}`, name, size, cat, style: STYLES[sk], status: '需確認實物' }));
